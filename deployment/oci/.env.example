# Copy outside the repository to /etc/claim2car/compose.env; never put credentials here.
# Resolve all images to verified immutable sha256 digests before starting Compose.
C2C_IMAGE=iad.ocir.io/example/claim2car/integrated@sha256:REPLACE_WITH_VERIFIED_DIGEST
C2C_POSTGRES_IMAGE=docker.io/library/postgres@sha256:REPLACE_WITH_VERIFIED_DIGEST
C2C_CADDY_IMAGE=docker.io/library/caddy@sha256:REPLACE_WITH_VERIFIED_DIGEST
C2C_DOMAIN=claim2car.example.invalid
